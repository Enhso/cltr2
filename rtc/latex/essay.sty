% essay.sty: layout for "More Agents, More Rogues?", borrowed from the CV
% (~/projects/cv/cv.sty).
%
% Same grid, type and colour as the CV: a narrow rail on the left holds section
% numbers and figure and table labels, the main column holds everything else.
% The body is set larger and the measure is narrower than the CV's, for reading
% at length.
%
% Build with XeLaTeX (make).

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{essay}

% The main column is 134mm (164mm text width less the 30mm rail span); the
% figures in figures/ are drawn at exactly that width.
\RequirePackage[a4paper, top=20mm, bottom=24mm, left=18mm, right=28mm, footskip=10mm]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xcolor}
\RequirePackage{changepage}
\RequirePackage{enumitem}
\RequirePackage{needspace}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{flafter}
\RequirePackage{microtype}
\RequirePackage{xurl}
\RequirePackage{hyperref}

% ---------------------------------------------------------------- colour
\definecolor{ink}{HTML}{17181A}
\definecolor{soft}{HTML}{5A5C60}
\definecolor{faint}{HTML}{B9BCB4}
\definecolor{accent}{HTML}{B4232A}
\definecolor{link}{HTML}{1B4B9E}

\hypersetup{colorlinks, linkcolor=ink, urlcolor=link, citecolor=ink}
\urlstyle{same}

% ---------------------------------------------------------------- type
\setmainfont{SourceSerifPro}[
    Extension = .otf,
    UprightFont = *-Regular,
    BoldFont = *-Semibold,
    ItalicFont = *-RegularIt,
    BoldItalicFont = *-SemiboldIt]
\setmonofont{SourceCodePro}[
    Extension = .otf,
    UprightFont = *-Regular,
    BoldFont = *-Semibold,
    ItalicFont = *-RegularIt,
    Scale = MatchLowercase]
\newfontfamily\franklin{LibreFranklin}[
    Extension = .otf,
    UprightFont = *-Regular,
    BoldFont = *-SemiBold,
    ItalicFont = *-Italic,
    BoldItalicFont = *-SemiBoldItalic]
\newfontfamily\franklinheavy{LibreFranklin-ExtraBold.otf}

\renewcommand\normalsize{\fontsize{10.4}{15}\selectfont}
\renewcommand\small{\fontsize{9.6}{13.6}\selectfont}
\renewcommand\footnotesize{\fontsize{8.2}{11.2}\selectfont}
\newcommand\metasize{\fontsize{7.4}{10}\selectfont}
\newcommand\meta{\ttfamily\metasize\color{soft}}

\AtBeginDocument{\normalsize\color{ink}}
\setlength\parindent{0pt}
\setlength\parskip{6pt plus 1pt}
\frenchspacing
\raggedright
\pagestyle{fancy}

% ---------------------------------------------------------------- grid
\newlength\rail     \setlength\rail{25mm}
\newlength\railgap  \setlength\railgap{5mm}
\newlength\railspan \setlength\railspan{\dimexpr\rail+\railgap\relax}

% Everything below the header sits in the main column.
\newenvironment{body}{\begin{adjustwidth}{\railspan}{0pt}\raggedright}{\end{adjustwidth}}

% Hangs material in the rail, aligned with the first line of the paragraph.
% The box is given no depth so it never pushes the next line down.
\newcommand\inrail[1]{%
    \leavevmode\llap{\raisebox{0pt}[\height][0pt]{%
        \parbox[t]{\rail}{\raggedright\leavevmode\meta #1}}\hspace{\railgap}}}

% ---------------------------------------------------------------- header
% \essayheader{title}{standfirst}{meta lines, separated by \\}
\newcommand\essayheader[3]{%
    \noindent
    \begin{minipage}[b]{0.66\textwidth}
        \raggedright{\franklinheavy\fontsize{30}{31}\selectfont #1\par}
    \end{minipage}\hfill
    \begin{minipage}[b]{0.32\textwidth}
        \raggedleft\ttfamily\fontsize{7.4}{10.4}\selectfont #3
    \end{minipage}\par
    \vspace{10pt}
    \noindent{\color{accent}\rule{\rail}{3pt}}{\color{ink}\rule{\dimexpr\textwidth-\rail}{0.8pt}}\par
    \vspace{12pt}
    \begin{body}
        {\franklin\fontsize{11.6}{16}\selectfont\color{soft}#2\par}
    \end{body}
    \vspace{6pt}}

% ---------------------------------------------------------------- sections
% \essaysection{number}{title}: number in the rail, title and a hairline across.
% An empty number leaves the rail blank.
\newcounter{essaysection}
\newcommand\essaysection[2]{%
    \par\addvspace{20pt}\needspace{4\baselineskip}%
    \stepcounter{essaysection}%
    \pdfbookmark[1]{\if\relax\detokenize{#1}\relax\else#1. \fi#2}{essaysection.\theessaysection}%
    \inrail{\franklinheavy\fontsize{13}{13}\selectfont\color{accent}#1}%
    {\franklin\bfseries\fontsize{8.6}{11}\selectfont
        \addfontfeature{LetterSpace=14}\MakeUppercase{#2}}%
    \hspace{8pt}{\color{faint}\leaders\hrule height 3.3pt depth -2.7pt\hfill}%
    \par\nobreak\vspace{2pt}}

% A bold lead-in at the start of a paragraph or list item.
\newcommand\runin[1]{{\franklin\bfseries\fontsize{9.6}{12}\selectfont #1}}

% Secondary text in a title.
\newcommand\aside[1]{{\mdseries\color{soft}#1}}

\newcommand\code[1]{\texttt{#1}}
\newcommand\link[2]{\href{#1}{#2}}

% A placeholder still to fill before sending: prints in red so it cannot ship unnoticed.
\newcommand\todo[1]{\textcolor{accent}{\bfseries[#1]}}

% ---------------------------------------------------------------- lists
\newlist{points}{itemize}{1}
\setlist[points]{
    label = {\textcolor{accent}{\rule[0.32ex]{3.5pt}{3.5pt}}},
    leftmargin = 12pt,
    labelsep = 7pt,
    topsep = 0pt,
    itemsep = 4pt,
    parsep = 0pt,
    partopsep = 0pt}

\newlist{steps}{enumerate}{1}
\setlist[steps]{
    label = {\textcolor{accent}{\franklin\bfseries\fontsize{9.6}{12}\selectfont\arabic*}},
    leftmargin = 14pt,
    labelsep = 7pt,
    topsep = 0pt,
    itemsep = 4pt,
    parsep = 0pt,
    partopsep = 0pt}

% ---------------------------------------------------------------- figures and tables
% Both float, and both set their contents in the main column with the label in
% the rail, the title in Franklin above and the note in mono below.
\newcommand\floattitle[2]{%
    \inrail{\addfontfeature{LetterSpace=8}\MakeUppercase{#1}}%
    {\franklin\bfseries\fontsize{9.6}{12.6}\selectfont #2\par}}

% \essayfigure{number}{file in figures/}{title}{subtitle}{source note}
\newcommand\essayfigure[5]{%
    \begin{figure}[tp]
    \begin{adjustwidth}{\railspan}{0pt}
        \floattitle{Figure #1}{#3}
        {\franklin\fontsize{8.6}{11.6}\selectfont\color{soft}#4\par}
        \vspace{8pt}
        \includegraphics[width=\linewidth]{figures/#2}\par
        \vspace{6pt}
        {\meta\raggedright #5\par}
    \end{adjustwidth}
    \end{figure}}

% \begin{essaytable}{number}{title}{note below, may be empty} tabular \end{essaytable}
\NewDocumentEnvironment{essaytable}{m m m}{%
    \begin{table}[tp]
    \begin{adjustwidth}{\railspan}{0pt}
        \floattitle{Table #1}{#2}
        \vspace{6pt}
        \fontsize{9}{12}\selectfont\addfontfeatures{Numbers={Lining,Monospaced}}%
        \renewcommand\arraystretch{1.15}%
}{%
        \par
        \if\relax\detokenize{#3}\relax\else\vspace{6pt}{\meta\raggedright #3\par}\fi
    \end{adjustwidth}
    \end{table}}

% A column header in a table, and a confidence interval set in grey.
\newcommand\colhead[1]{{\franklin\bfseries\fontsize{8}{10}\selectfont\color{soft}#1}}
\newcommand\ci[1]{{\color{soft}\,[#1]}}

% Header cells wrap from the bottom, so one-line headers sit on the rule.
\renewcommand\tabularxcolumn[1]{b{#1}}
\setlength\heavyrulewidth{0.7pt}
\setlength\lightrulewidth{0.4pt}
\setlength\textfloatsep{18pt plus 4pt minus 4pt}
\setlength\floatsep{18pt plus 4pt minus 4pt}
% Floats go to the top of a page after the one that cites them (flafter plus
% [tp]); these let a tall figure share a page with text instead of standing alone.
\renewcommand\topfraction{0.85}
\renewcommand\textfraction{0.1}
\renewcommand\floatpagefraction{0.8}
\widowpenalty=10000
\clubpenalty=10000

% ---------------------------------------------------------------- examples box
% \begin{casebox}{title}{aside}: worked examples between two hairlines, a step smaller.
\NewDocumentEnvironment{casebox}{m m}{%
    \par\addvspace{10pt}%
    {\color{faint}\rule{\linewidth}{0.6pt}}\par
    \small\setlength\parskip{5pt plus 1pt}%
    \inrail{\addfontfeature{LetterSpace=8}EXAMPLES}{\franklin\bfseries\fontsize{9.6}{12.6}\selectfont #1}%
    \if\relax\detokenize{#2}\relax\else\ {\franklin\fontsize{8.6}{12.6}\selectfont\color{soft}(#2)}\fi\par
}{%
    \par\vspace{4pt}%
    {\color{faint}\rule{\linewidth}{0.6pt}}\par
    \addvspace{10pt}}

% ---------------------------------------------------------------- footnotes
% Footnotes sit in the main column, the number hanging just left of the text.
\renewcommand\footnoterule{%
    \kern-3pt\moveright\railspan\hbox{\color{faint}\rule{30mm}{0.5pt}}\kern2.6pt}
\renewcommand\@makefntext[1]{%
    \leftskip\railspan\parindent0pt\raggedright
    \noindent\llap{{\franklin\fontsize{7.6}{10}\selectfont\color{soft}\@thefnmark}\hspace{5pt}}#1}
\setlength\footnotesep{10pt}

% ---------------------------------------------------------------- footer
\newcommand\essayfooter[2]{% author, title
    \fancyhf{}
    \renewcommand\headrulewidth{0pt}
    \fancyfoot[L]{\meta #1\hspace{0.5em}{\color{faint}·}\hspace{0.5em}#2}
    \fancyfoot[R]{\meta page \thepage/\pageref*{LastPage}}}
